{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhoor:protocol:response:v1",
  "title": "ZHOOR decision protocol response, version 1",
  "description": "Canonical Decision Plane response envelope. Dispositions resolved/abstained/escalated/denied are not result kinds; choice/score/extract/verdict are result kinds. Confidence is bounded advice, never authorization, and is separate from evidence trust. Unknown fields and unknown versions fail closed. Cross-envelope rules (request linkage, candidate containment, evidence linkage, deadline accounting) are enforced by the deterministic Rust validator because JSON Schema cannot compare two documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "confidence",
    "disposition",
    "uncertainty",
    "evidence_refs",
    "backend",
    "latency",
    "trace_id"
  ],
  "properties": {
    "protocol_version": { "const": "1" },
    "request_id": { "$ref": "#/$defs/uuid" },
    "result": { "$ref": "#/$defs/result" },
    "error": { "$ref": "#/$defs/error" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "disposition": { "enum": ["resolved", "abstained", "escalated", "denied"] },
    "uncertainty": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "backend": { "enum": ["deterministic", "index", "local", "remote"] },
    "latency": { "$ref": "#/$defs/latency" },
    "trace_id": { "$ref": "#/$defs/uuid" }
  },
  "allOf": [
    {
      "if": { "properties": { "disposition": { "const": "resolved" } }, "required": ["disposition"] },
      "then": { "required": ["result"], "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "disposition": { "const": "abstained" } }, "required": ["disposition"] },
      "then": { "not": { "anyOf": [{ "required": ["result"] }, { "required": ["error"] }] } }
    },
    {
      "if": { "properties": { "disposition": { "const": "escalated" } }, "required": ["disposition"] },
      "then": { "not": { "anyOf": [{ "required": ["result"] }, { "required": ["error"] }] } }
    },
    {
      "if": { "properties": { "disposition": { "const": "denied" } }, "required": ["disposition"] },
      "then": { "required": ["error"], "not": { "required": ["result"] } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "trust_tier", "source"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^evidence://sha256/[0-9a-f]{64}$"
        },
        "kind": { "enum": ["user_input", "registry", "tool_result", "memory", "external_document"] },
        "trust_tier": { "enum": ["untrusted", "observed", "verified", "policy"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "calibrated", "calibration_ref"],
      "properties": {
        "raw": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibrated": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibration_ref": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_ms", "load_ms", "inference_ms"],
      "properties": {
        "queue_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "load_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "inference_ms": { "type": "integer", "minimum": 0, "maximum": 600000 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["choice", "score", "extract", "verdict"] },
        "value": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "choice" } }, "required": ["kind"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/choiceValue" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "score" } }, "required": ["kind"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/scoreValue" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "extract" } }, "required": ["kind"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/extractValue" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "verdict" } }, "required": ["kind"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/verdictValue" } } }
        }
      ]
    },
    "choiceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choices"],
      "properties": {
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "scoreValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "score", "threshold"],
      "properties": {
        "scale": { "const": "unit_interval" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "extractValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/extractedField" }
        }
      }
    },
    "extractedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": ["string", "number", "boolean", "null"], "maxLength": 4096 },
        "evidence": { "$ref": "#/$defs/evidenceReference" }
      }
    },
    "verdictValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": { "enum": ["supported", "unsupported", "insufficient"] }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "unknown_operation",
            "unknown_worker_kind",
            "unknown_result_kind",
            "invalid_disposition",
            "unknown_trust_tier",
            "unknown_backend",
            "invalid_confidence",
            "invalid_budget",
            "invalid_deadline",
            "invalid_id",
            "missing_field",
            "unknown_field",
            "invalid_evidence_reference",
            "over_budget",
            "inconsistent_envelope",
            "invalid_result",
            "malformed_json",
            "denied_by_policy"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}