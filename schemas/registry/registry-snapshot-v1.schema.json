{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zhoor:registry:snapshot:v1",
  "title": "ZHOOR compact skill registry snapshot v1",
  "description": "Closed registry document. Protocol-owned metadata definitions mirror the protocol registry snapshot schema and are parity-tested; Rust validation delegates those values to zhoor-protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_format_version",
    "registry_version",
    "skills"
  ],
  "properties": {
    "descriptor_format_version": { "$ref": "#/$defs/descriptorFormatVersion" },
    "registry_version": { "$ref": "#/$defs/registryVersion" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/descriptor" }
    }
  },
  "$defs": {
    "descriptorFormatVersion": { "const": "1" },
    "registryVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of exact raw SKILL.md bytes only; not metadata, authentication, trust, authorization, anonymization, or a signature."
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "capabilities",
        "requires",
        "activation",
        "risk_level",
        "artifact_sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "description": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "activation": {
          "type": "string",
          "enum": ["always", "contextual", "explicit", "manual", "dependency"]
        },
        "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
        "artifact_sha256": { "$ref": "#/$defs/artifactSha256" }
      }
    }
  }
}
